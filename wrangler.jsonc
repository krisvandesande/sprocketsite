// Static one-pager for sprocketexif.app, served straight from Workers static assets (no Worker
// script). Deploy with `npm run deploy` from this folder.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sprocketsite",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "sprocketexif.app", "custom_domain": true },
    { "pattern": "www.sprocketexif.app", "custom_domain": true }
  ]
}
