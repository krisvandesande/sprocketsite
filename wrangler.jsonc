// Static one-pager for sprocketexif.app, served straight from Workers static assets (no Worker
// script). Deploy with `npm run deploy` from this folder.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sprocketsite",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    // Zone routes, not custom domains: the zone's existing DNS records stay as they are.
    { "pattern": "sprocketexif.app/*", "zone_name": "sprocketexif.app" },
    { "pattern": "www.sprocketexif.app/*", "zone_name": "sprocketexif.app" }
  ]
}
